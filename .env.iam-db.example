# Copy this file to .env.iam-db. It is read only by the IAM Flyway container.
# Keep the real file outside version control and do not place signing keys here.
FLYWAY_URL=jdbc:postgresql://iam-database-postgres:5432/acom_iam
FLYWAY_USER=CHANGE_IAM_USER
FLYWAY_PASSWORD=CHANGE_IAM_PASSWORD
FLYWAY_CONNECT_RETRIES=30
