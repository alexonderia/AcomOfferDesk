{
  "name": "order-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "e2e:smoke": "playwright test --config playwright.config.ts --grep @smoke",
    "e2e:roles": "playwright test --config playwright.config.ts --grep @roles",
    "e2e:registration": "playwright test --config playwright.config.ts --grep @registration",
    "e2e:request-offer": "playwright test --config playwright.config.ts --grep @request-offer",
    "e2e:dashboard": "playwright test --config playwright.config.ts --grep @dashboard",
    "e2e:files-chat": "playwright test --config playwright.config.ts --grep @files-chat",
    "e2e:extended": "playwright test --config playwright.config.ts --grep \"@roles|@registration|@request-offer|@dashboard|@files-chat\""
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@hookform/resolvers": "^3.9.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.2",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^4.1.5"
  }
}
