# Copy this file to .env.iam. Keep the real file outside version control.
# IAM owns a separate PostgreSQL database and is the only service that receives
# the signing private key. AcomOfferDesk receives only IAM_SIGNING_PUBLIC_KEY.

APP_ENV=development

# SQLAlchemy runtime URL for the IAM database.
IAM_DATABASE_URL=postgresql+asyncpg://CHANGE_IAM_USER:CHANGE_IAM_PASSWORD@iam-database-postgres:5432/acom_iam

IAM_PUBLIC_BASE_URL=http://localhost:8080/iam
IAM_ISSUER=http://localhost:8080/iam
IAM_AUDIENCE=acomofferdesk
IAM_ALLOWED_REDIRECT_URIS=http://localhost:8080/api/v1/auth/callback

# Generate an RSA key pair outside the repository. Encode PEM line breaks as \n.
IAM_SIGNING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----
IAM_SIGNING_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nCHANGE_ME\n-----END PUBLIC KEY-----
IAM_SIGNING_KID=iam-signing-1

# Use independent random values of at least 32 characters.
IAM_INTERNAL_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM_INTERNAL_SERVICE_TOKEN
IAM_AUTH_REQUEST_SECRET=CHANGE_ME_LONG_RANDOM_AUTH_REQUEST_SECRET
IAM_TOKEN_HASH_SECRET=CHANGE_ME_LONG_RANDOM_TOKEN_HASH_SECRET

IAM_ACCESS_TOKEN_TTL_SECONDS=300
IAM_AUTHORIZATION_CODE_TTL_SECONDS=60
IAM_ACTION_TOKEN_TTL_SECONDS=3600
IAM_REFRESH_IDLE_TTL_SECONDS=1800
IAM_REFRESH_MAX_TTL_SECONDS=43200
IAM_LOGIN_MAX_FAILURES=5
IAM_LOGIN_LOCK_SECONDS=900
IAM_LOGIN_RATE_LIMIT_ATTEMPTS=20
IAM_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
IAM_COOKIE_SECURE=false
IAM_WORKERS=1
