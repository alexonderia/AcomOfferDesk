# Copy to `.env.prod-like.local` (local production-like) or adapt for test/prod.
# Do not commit real secrets.
# This file is used both as:
# 1. Docker Compose interpolation input via `--env-file .env.prod-like.local`
# 2. Runtime env file for services via `APP_RUNTIME_ENV_FILE=.env.prod-like.local`

APP_RUNTIME_ENV_FILE=.env.prod-like.local
APP_ENV=production
IAM_RUNTIME_ENV_FILE=./.env.iam
IAM_MIGRATION_ENV_FILE=./.env.iam-db

# --- PostgreSQL application database ---
DATABASE_URL=postgresql://CHANGE_USER:CHANGE_STRONG_DB_PASSWORD@order-database-postgres:5432/order_database

# --- Legacy local JWT/session settings ---
JWT_SECRET=CHANGE_ME_64PLUS_CHAR_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=60
ACCESS_TOKEN_TTL_SECONDS=300
WS_TICKET_TTL_SECONDS=30
WS_LEGACY_QUERY_TOKEN_ENABLED=false
REFRESH_TOKEN_IDLE_TTL_SECONDS=1800
REFRESH_TOKEN_MAX_TTL_SECONDS=43200
REFRESH_COOKIE_NAME=acom_refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=app.example.com
# REFRESH_TOKEN_SECRET=CHANGE_ME_SEPARATE_REFRESH_SECRET

# --- IAM adapter ---
IAM_INTERNAL_BASE_URL=http://iam:8100
IAM_PUBLIC_BASE_URL=https://app.example.com/iam
IAM_ISSUER=https://app.example.com/iam
IAM_AUDIENCE=acomofferdesk
IAM_SIGNING_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nCHANGE_ME\n-----END PUBLIC KEY-----
IAM_SIGNING_KID=iam-signing-1
IAM_INTERNAL_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM_INTERNAL_SERVICE_TOKEN
IAM_HTTP_TIMEOUT_SECONDS=10
IAM_ACCESS_COOKIE_NAME=acom_iam_access
IAM_REFRESH_COOKIE_NAME=acom_iam_refresh
IAM_STATE_COOKIE_NAME=acom_iam_flow
IAM_CSRF_COOKIE_NAME=acom_csrf

# --- Public URLs ---
WEB_BASE_URL=https://app.example.com
PUBLIC_BACKEND_BASE_URL=https://app.example.com

# --- E2E smoke (никогда не коммитьте реальные значения) ---
# E2E_BASE_URL=https://app.example.com
# E2E_STRICT_CREDENTIALS=false
# E2E_SUPERADMIN_USERNAME=
# E2E_SUPERADMIN_PASSWORD=
# E2E_ECONOMIST_USERNAME=
# E2E_ECONOMIST_PASSWORD=
# E2E_CONTRACTOR_USERNAME=
# E2E_CONTRACTOR_PASSWORD=

# --- SMTP / email verification ---
EMAIL_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=AcomOfferDesk
EMAIL_APP_PASSWORD=CHANGE_ME_STRONG_SMTP_APP_PASSWORD
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls

# --- IMAP (optional) ---
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USERNAME=mailbox@example.com
# IMAP_PASSWORD=CHANGE_ME_STRONG_IMAP_PASSWORD
IMAP_MAILBOX=INBOX
REQUEST_MAILBOX_POLL_LIMIT=20
REQUEST_MAILBOX_POLL_INTERVAL_SECONDS=60

# --- Email token secrets ---
EMAIL_VERIFICATION_SECRET=CHANGE_ME_STRONG_EMAIL_VERIFICATION_SECRET
EMAIL_VERIFICATION_TTL_SECONDS=3600
EMAIL_REPLY_SECRET=CHANGE_ME_STRONG_EMAIL_REPLY_SECRET
EMAIL_REPLY_TTL_SECONDS=604800
# Absolute or relative path from backend runtime cwd (example path in repo):
CONTRACTOR_INVITE_MAX_EMAILS_PER_REQUEST=50
INVITATION_PORTAL_URL=https://app.example.com/login
INVITATION_CONTACT_NAME=Владислав Хлистун
INVITATION_CONTACT_EMAIL=VKhlistun@alabuga.ru
INVITATION_CONTACT_PHONE=+7 927 455-80-89
INVITATION_CONTACT_TEXT=

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=CHANGE_ME_STRONG_RABBITMQ_USER
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://CHANGE_ME_STRONG_RABBITMQ_USER:CHANGE_ME_STRONG_RABBITMQ_PASSWORD@rabbitmq:5672/

# --- Optional smoke override endpoints (when smoke runs outside Docker network) ---
# SMOKE_DATABASE_URL=postgresql://CHANGE_USER:CHANGE_STRONG_DB_PASSWORD@localhost:5432/order_database
# SMOKE_S3_ENDPOINT=localhost:9000
# SMOKE_RABBITMQ_URL=amqp://CHANGE_ME_STRONG_RABBITMQ_USER:CHANGE_ME_STRONG_RABBITMQ_PASSWORD@localhost:5672/

# --- S3 / MinIO ---
MINIO_ROOT_USER=CHANGE_ME_STRONG_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_ROOT_PASSWORD
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=CHANGE_ME_STRONG_MINIO_ROOT_USER
S3_SECRET_KEY=CHANGE_ME_STRONG_MINIO_ROOT_PASSWORD
S3_BUCKET=acom-offerdesk
S3_SECURE=false
# Use an internal/admin hostname only if direct object access is required.
S3_PUBLIC_ENDPOINT=https://storage.internal.example
S3_PRESIGNED_GET_TTL_SECONDS=300
MAX_UPLOAD_SIZE_BYTES=5242880
FILE_GUARD_ENABLED=true
FILE_GUARD_URL=http://file_guard:8080
FILE_GUARD_TIMEOUT_SECONDS=10
FILE_GUARD_MAX_FILE_SIZE_BYTES=5242880
FILE_GUARD_ANTIVIRUS_ENABLED=true
# В production держите true: file_guard станет 503, если антивирус отключат.
FILE_GUARD_REQUIRE_ANTIVIRUS=true
FILE_GUARD_ANTIVIRUS_TIMEOUT_SECONDS=10
FILE_GUARD_SCAN_TIMEOUT_SECONDS=30
FILE_GUARD_CLAMD_SOCKET_PATH=/run/clamav/clamd.sock
FILE_GUARD_CLAMAV_UPDATE_ON_START=true
FILE_GUARD_OFFICE_MAX_ENTRIES=200
FILE_GUARD_OFFICE_MAX_TOTAL_UNCOMPRESSED_BYTES=41943040
FILE_GUARD_OFFICE_MAX_ENTRY_UNCOMPRESSED_BYTES=12582912
FILE_GUARD_OFFICE_MAX_COMPRESSION_RATIO=120
FILE_GUARD_OFFICE_MAX_XML_SCAN_BYTES=1048576
FILE_GUARD_OFFICE_MAX_ENTRY_NAME_LENGTH=255
FILE_GUARD_UPLOAD_READ_CHUNK_BYTES=1048576
FILE_GUARD_IMAGE_MAX_WIDTH=12000
FILE_GUARD_IMAGE_MAX_HEIGHT=12000
FILE_GUARD_IMAGE_MAX_PIXELS=40000000

# --- CORS ---
