  {
    "kind": "p",
    "style": "Heading 3",
    "numbered": false,
    "text": "Самостоятельная регистрация"
  },
  {
    "kind": "p",
    "style": "Compact",
    "numbered": true,
    "text": "Получите ссылку на регистрацию по email."
  },
  {
    "kind": "p",
    "style": "Compact",
    "numbered": true,
    "text": "Перейдите по ссылке."
  },
  {
    "kind": "p",
    "style": "Compact",
    "numbered": true,
    "text": "Заполните регистрационные данные."
  },
  {
    "kind": "p",
    "style": "Compact",
    "numbered": true,
    "text": "Подтвердите электронную почту."
  },
  {
    "kind": "p",
    "style": "Compact",
    "numbered": true,
    "text": "Дождитесь проверки данных."
