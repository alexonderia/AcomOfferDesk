# РЎРєРѕРїРёСЂСѓР№С‚Рµ СЌС‚РѕС‚ С„Р°Р№Р» РІ `.env` РІ РєРѕСЂРЅРµ РїСЂРѕРµРєС‚Р°. РќРµ РєРѕРјРјРёС‚СЊС‚Рµ СЂРµР°Р»СЊРЅС‹Рµ СЃРµРєСЂРµС‚С‹.
# Р­С‚Рѕ РµРґРёРЅС‹Р№ runtime/env contract РґР»СЏ Р»РѕРєР°Р»СЊРЅРѕРіРѕ Р·Р°РїСѓСЃРєР° РІСЃРµРіРѕ СЃС‚РµРєР° РёР· РєРѕСЂРЅСЏ РїСЂРѕРµРєС‚Р°.
# РџРµСЂРµРјРµРЅРЅС‹Рµ С‡РёС‚Р°СЋС‚СЃСЏ Docker Compose, backend, keycloak, notifications_worker Рё init-СЃРµСЂРІРёСЃР°РјРё.
#
# Р”Р»СЏ production-like/test/prod СѓРґРѕР±РЅРѕ РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ РѕС‚РґРµР»СЊРЅС‹Рµ РєРѕСЂРЅРµРІС‹Рµ env-С„Р°Р№Р»С‹:
# - `.env.dev`
# - `.env.test`
# - `.env.prod-like.local`
# - `.env.prod`
#
# APP_ENV С‡РёС‚Р°РµС‚ backend.
# KEYCLOAK_VERIFY_EMAIL С‡РёС‚Р°РµС‚ infra/keycloak/bootstrap.sh.

APP_ENV=production

# --- PostgreSQL application database ---
DATABASE_URL=postgresql://CHANGE_USER:CHANGE_PASSWORD@order-database-postgres:5432/order_database

# --- Legacy local JWT/session settings (kept for staged rollout) ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=60
ACCESS_TOKEN_TTL_SECONDS=300
WS_TICKET_TTL_SECONDS=30
WS_LEGACY_QUERY_TOKEN_ENABLED=false
REFRESH_TOKEN_IDLE_TTL_SECONDS=1800
REFRESH_TOKEN_MAX_TTL_SECONDS=43200
REFRESH_COOKIE_NAME=acom_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=
# REFRESH_TOKEN_SECRET=

# --- Keycloak / OIDC ---
KEYCLOAK_ENABLED=true
KEYCLOAK_REALM=acom-offerdesk
KEYCLOAK_WEB_CLIENT_ID=acom-web
# Legacy alias (optional): KEYCLOAK_CLIENT_ID=acom-web
KEYCLOAK_API_CLIENT_ID=acom-api
KEYCLOAK_INTERNAL_BASE_URL=http://keycloak:8080/iam
KEYCLOAK_PUBLIC_BASE_URL=http://localhost:8080/iam
KEYCLOAK_ISSUER_URL=http://localhost:8080/iam/realms/acom-offerdesk
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300
KEYCLOAK_HTTP_TIMEOUT_SECONDS=10
KEYCLOAK_REFRESH_COOKIE_NAME=acom_oidc_refresh
KEYCLOAK_STATE_COOKIE_NAME=acom_oidc_state
KEYCLOAK_BOOTSTRAP_BINDING_ENABLED=true
KEYCLOAK_BOOTSTRAP_APP_USERNAME=superadmin
KEYCLOAK_VERIFY_EMAIL=true
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=acom-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
# Optional fallback for password grant:
# KEYCLOAK_ADMIN_USERNAME=
# KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DEV_AUTO_LINK_BY_USERNAME_ENABLED=false
KEYCLOAK_PROD_AUTO_LINK_BY_VERIFIED_EMAIL_ENABLED=true
# Keep enabled in test branches to align existing linked users with app.* role by users.id_role during init.
KEYCLOAK_INIT_SYNC_EXISTING_USERS_BY_ROLE=true

# --- Keycloak container bootstrap ---
KEYCLOAK_START_COMMAND=start-dev
KC_BOOTSTRAP_ADMIN_USERNAME=kc_bootstrap_admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_MASTER_ADMIN_PASSWORD
KEYCLOAK_BOOTSTRAP_APP_PASSWORD=CHANGE_ME_APP_SUPERADMIN_PASSWORD
KEYCLOAK_BOOTSTRAP_APP_EMAIL=superadmin@example.com
KEYCLOAK_BOOTSTRAP_APP_FIRST_NAME=Bootstrap
KEYCLOAK_BOOTSTRAP_APP_LAST_NAME=Superadmin

# --- Keycloak PostgreSQL schema (same DB, isolated schema) ---
KC_DB=postgres
KC_DB_URL_HOST=order-database-postgres
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=order_database
KC_DB_USERNAME=CHANGE_USER
KC_DB_PASSWORD=CHANGE_PASSWORD
KC_DB_SCHEMA=keycloak
KC_HTTP_ENABLED=true
KC_HTTP_RELATIVE_PATH=/iam
KC_PROXY_HEADERS=xforwarded
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_HOSTNAME=http://localhost:8080/iam

# --- Public URLs ---
WEB_BASE_URL=http://localhost:8080
PUBLIC_BACKEND_BASE_URL=http://localhost:8080

# --- Registration owner alerts (NOT max-bot-log; NOT MAX messenger bot) ---
# РќРѕРІС‹Р№ РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ в†’ incident-relay в†’ YouGile в†’ Hermes vps в†’ Telegram @Hermes_koara_bot
REGISTRATION_NOTIFY_ENABLED=false
REGISTRATION_NOTIFY_URL=http://incident-relay:8080/ingest/registration
# РћРїС†РёРѕРЅР°Р»СЊРЅРѕ, РµСЃР»Рё РЅР° relay Р·Р°РґР°РЅ REGISTRATION_INGEST_TOKEN
REGISTRATION_NOTIFY_TOKEN=
REGISTRATION_NOTIFY_SERVICE=acom-registration
REGISTRATION_NOTIFY_TIMEOUT_SECONDS=5

# --- Legacy Telegram integration ---
LEGACY_TELEGRAM_ENABLED=false
TG_BOT_PUBLIC_URL=https://t.me/YOUR_BOT_USERNAME

# --- Telegram links ---
TG_LINK_SECRET=CHANGE_ME_RANDOM_SECRET

# --- SMTP / email verification ---
EMAIL_ADDRESS=your-mail@example.com
EMAIL_FROM_NAME=AcomOfferDesk
EMAIL_APP_PASSWORD=CHANGE_APP_PASSWORD
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=auto
# KEYCLOAK_SMTP_USERNAME=
# KEYCLOAK_SMTP_PASSWORD=
# KEYCLOAK_SMTP_HOST=smtp.example.com
# KEYCLOAK_SMTP_PORT=587
# KEYCLOAK_SMTP_FROM=
# KEYCLOAK_SMTP_REPLY_TO=
# KEYCLOAK_SMTP_FROM_DISPLAY_NAME=
# KEYCLOAK_SMTP_AUTH=true
# KEYCLOAK_SMTP_SSL=false
# KEYCLOAK_SMTP_STARTTLS=true

# --- IMAP (optional) ---
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USERNAME=
# IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
REQUEST_MAILBOX_POLL_LIMIT=20
REQUEST_MAILBOX_POLL_INTERVAL_SECONDS=60

# --- Email token secrets ---
EMAIL_VERIFICATION_SECRET=CHANGE_ME_EMAIL_VERIFICATION_SECRET
EMAIL_VERIFICATION_TTL_SECONDS=3600
EMAIL_REPLY_SECRET=CHANGE_ME_EMAIL_REPLY_SECRET
EMAIL_REPLY_TTL_SECONDS=604800
# Absolute or relative path from backend runtime cwd (example path in repo):
CONTRACTOR_INVITE_MAX_EMAILS_PER_REQUEST=50
INVITATION_PORTAL_URL=http://localhost:8080/login
INVITATION_CONTACT_NAME=Владислав Хлистун
INVITATION_CONTACT_EMAIL=VKhlistun@alabuga.ru
INVITATION_CONTACT_PHONE=+7 927 455-80-89
INVITATION_CONTACT_TEXT=

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- S3 / MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_SAME_AS_S3_SECRET_KEY
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME_SAME_AS_MINIO_ROOT_PASSWORD
S3_BUCKET=acom-offer-desk
S3_SECURE=false
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PRESIGNED_GET_TTL_SECONDS=300
MAX_UPLOAD_SIZE_BYTES=5242880
FILE_GUARD_ENABLED=true
FILE_GUARD_URL=http://file_guard:8080
FILE_GUARD_TIMEOUT_SECONDS=10
FILE_GUARD_MAX_FILE_SIZE_BYTES=5242880
FILE_GUARD_ANTIVIRUS_ENABLED=true
FILE_GUARD_ANTIVIRUS_TIMEOUT_SECONDS=10
FILE_GUARD_CLAMD_SOCKET_PATH=/run/clamav/clamd.sock
FILE_GUARD_CLAMAV_UPDATE_ON_START=true
FILE_GUARD_OFFICE_MAX_ENTRIES=200
FILE_GUARD_OFFICE_MAX_TOTAL_UNCOMPRESSED_BYTES=41943040
FILE_GUARD_OFFICE_MAX_ENTRY_UNCOMPRESSED_BYTES=12582912
FILE_GUARD_OFFICE_MAX_COMPRESSION_RATIO=120
FILE_GUARD_OFFICE_MAX_XML_SCAN_BYTES=1048576
FILE_GUARD_OFFICE_MAX_ENTRY_NAME_LENGTH=255
FILE_GUARD_UPLOAD_READ_CHUNK_BYTES=1048576
FILE_GUARD_IMAGE_MAX_WIDTH=12000
FILE_GUARD_IMAGE_MAX_HEIGHT=12000
FILE_GUARD_IMAGE_MAX_PIXELS=40000000

# --- Telegram flow TTLs ---
TG_REGISTER_TTL_SECONDS=86400
TG_AUTH_TTL_SECONDS=600
TG_REQUEST_TTL_SECONDS=604800

# --- CORS ---
# CORS_ALLOW_ORIGINS=http://localhost:8080,https://your-domain.example
