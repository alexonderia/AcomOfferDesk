# Скопируйте в max_bot/.env (файл в .gitignore).
# Источник: max_bot/src/app/core/config.py

# Бот не запустится, пока MAX_BOT_ENABLED != true (должно совпадать с backend MAX_BOT_ENABLED).
MAX_BOT_ENABLED=true
MAX_BOT_TOKEN=
BACKEND_BASE_URL=http://backend:8000
PUBLIC_BACKEND_BASE_URL=
MAX_BOT_TIMEOUT_SECONDS=10
MAX_POLLING_ENABLED=true
# Общий секрет для вызовов бот → backend. Должен совпадать с BOT_API_SHARED_SECRET в backend/.env.
# В production backend требует его при включённом боте.
BOT_API_SHARED_SECRET=
